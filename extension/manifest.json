{
  "manifest_version": 3,
  "name": "SafeBrowse",
  "version": "1.1.0",
  "description": "Review URL reputation, DNS and HTTPS security signals for the active tab.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://safe-browse-nu.vercel.app/*"
  ]
}
