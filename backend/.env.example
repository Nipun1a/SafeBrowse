PORT=5000

# Google v4, noncommercial. Web Risk is the fallback when v4 is unset.
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_WEB_RISK_API_KEY=

VIRUSTOTAL_API_KEY=
VIRUSTOTAL_SUBMIT_UNKNOWN=true

# Optional. Use rediss:// for Redis services requiring TLS.
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=2500
MONGO_URI=

# Optional path to the extracted Tranco rank,domain CSV (first 1000 ranks used).
TRANCO_LIST_PATH=

# Optional local OpenPhish text feed. Keep the file updated.
OPENPHISH_FEED_PATH=
